# Contact form email via Resend (app/api/contact/route.ts)
# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Resend API key (https://resend.com/api-keys). Server-side only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender shown on enquiry emails. Must use a domain verified in Resend,
# e.g. "Certify Right Website <enquiries@certifyright.com.au>".
# (onboarding@resend.dev works for testing, but only delivers to your Resend account's own email.)
CONTACT_FROM_EMAIL=

# Inbox that receives enquiries. Defaults to info@certifyright.com.au if unset.
CONTACT_TO_EMAIL=info@certifyright.com.au

# Vercel Blob read-write token, for PDF attachments over 4MB (up to 12MB). Vercel adds it
# automatically when a Blob store is connected to the project (Storage → Create → Blob,
# private access). Server-side only. Without it, PDFs up to 4MB still work.
BLOB_READ_WRITE_TOKEN=
