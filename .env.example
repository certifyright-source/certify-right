# Contact form email via Resend (app/api/contact/route.ts)
# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Resend API key (https://resend.com/api-keys). Server-side only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender shown on enquiry emails. Must use a domain verified in Resend,
# e.g. "Certify Right Website <enquiries@certifyright.com.au>".
# (onboarding@resend.dev works for testing, but only delivers to your Resend account's own email.)
CONTACT_FROM_EMAIL=

# Inbox that receives enquiries. Defaults to certifyright@gmail.com if unset.
CONTACT_TO_EMAIL=certifyright@gmail.com
